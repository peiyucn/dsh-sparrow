{
  "name": "@dsh-sparrow/dsh-codebuddy-credits",
  "description": "Company CodeBuddy credits as a DeepSeek Harness LLM provider — official API key, models only, no agent harness",
  "version": "0.1.0-alpha.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyucn/dsh-sparrow.git",
    "directory": "plugins/dsh-codebuddy-credits"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "codebuddy",
    "workbuddy",
    "llm",
    "provider",
    "cordis",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "CHANGELOG.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "verify": "node ../../scripts/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.1-rc.2 || ^4.0.1",
    "@deepseek-ai/dsh-credentials": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.2-alpha.4",
    "@deepseek-ai/dsh-settings": "^0.1.2-alpha.4"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2",
    "@earendil-works/pi-ai": "^0.84.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "0.1.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-launch-environment": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-llm-pi-ai": "0.1.2-alpha.5",
    "@deepseek-ai/dsh-settings": "0.1.2-alpha.5",
    "@types/node": "^22.20.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  }
}
