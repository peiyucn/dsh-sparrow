{
  "name": "@dsh-sparrow/dsh-nav-pin",
  "description": "DSH web plugin: keeps the turn navigation visible on narrow conversations (official 900px hide breakpoint moves to 700px, hover-reveal overlay below it) and caps the conversation content width so the rail stays clear of the drag handles",
  "version": "0.1.2-rc.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyucn/dsh-sparrow.git",
    "directory": "plugins/dsh-nav-pin"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md", "CHANGELOG.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "scripts": {
    "verify": "node ../../scripts/verify.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^0.1.1-rc.2 || ^4.0.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "0.1.1-rc.2",
    "@types/node": "^22.20.0"
  }
}
