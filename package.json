{
  "name": "dsh-sparrow",
  "private": true,
  "version": "0.2.0-rc.2",
  "description": "A collection of small DeepSeek Harness (DSH) web plugins",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "verify": "pnpm run check:paths && pnpm run check:dsh-pin && pnpm run check:plugin-docs && pnpm run verify:all",
    "check:paths": "node scripts/check-no-local-paths.mjs",
    "check:dsh-pin": "node scripts/check-dsh-pin.mjs",
    "check:plugin-docs": "node scripts/check-plugin-docs.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "typecheck:all": "node scripts/verify-all.mjs --typecheck",
    "build:all": "node scripts/verify-all.mjs --build",
    "package:all": "node scripts/verify-all.mjs --package",
    "test:all": "node scripts/verify-all.mjs --test"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "6.0.3"
  }
}