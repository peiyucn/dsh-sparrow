{
  "name": "dsh-sparrow",
  "version": "0.1.0",
  "description": "麻雀虽小,五脏俱全 — a small DSH web-plugin collection (FIM completion, archived-session manager, …)",
  "type": "module",
  "main": "src/host.ts",
  "exports": {
    ".": "./src/host.ts",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" }
  },
  "keywords": ["deepseek-harness", "dsh", "dsh-plugin", "fim", "session", "archive"],
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.14.0"
  }
}
